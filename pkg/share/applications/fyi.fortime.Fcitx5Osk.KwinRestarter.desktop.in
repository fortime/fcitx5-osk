[Desktop Entry]
Name=Fcitx 5 Osk Kwin Restarter
GenericName=Input Method
Comment=A helper to restart "Fcitx 5 Osk Kwin Launcher"
Exec=@INSTALL_BIN_DIR@/fcitx5-osk-kwin-launcher --switch-only --next-input-method=@INSTALL_DATA_DIR@/applications/fyi.fortime.Fcitx5Osk.KwinLauncher.desktop
Icon=fyi.fortime.Fcitx5Osk
Terminal=false
Type=Application
Categories=System;Utility;
StartupNotify=false
NoDisplay=true
OnlyShowIn=KDE
X-KDE-StartupNotify=false
X-KDE-Wayland-VirtualKeyboard=true
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management
